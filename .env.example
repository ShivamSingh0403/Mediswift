# ===================================================
# MediSwift 2.0 Production & Development Environment Template
# ===================================================
# Copy this file to .env and configure values before starting the application.
# IMPORTANT SECURITY NOTICE: Never commit real passwords, API keys, or production secrets to source control.

# ---------------------------------------------------
# 1. CORE DJANGO CONFIGURATION
# ---------------------------------------------------
# Set DEBUG=False in production. Never run production with DEBUG=True.
DEBUG=True
# Generate a cryptographically secure key for production (e.g. via `python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"`)
SECRET_KEY=django-insecure-mediswift-production-grade-secret-key-replace-in-prod-xyz123
# Comma-separated list of valid host/domain names
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,backend,web

# ---------------------------------------------------
# 2. DATABASE CONFIGURATION
# ---------------------------------------------------
# By default, if DATABASE_NAME is commented out, MediSwift automatically uses
# the zero-dependency SQLite database (backend/db.sqlite3) seeded with 262 products.
# For production PostgreSQL:
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=mediswift_db
# DATABASE_USER=postgres
# DATABASE_PASSWORD=your_secure_postgresql_password
# DATABASE_HOST=localhost
# DATABASE_PORT=5432

# ---------------------------------------------------
# 3. CORS & CSRF SECURITY
# ---------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------
# 4. JWT AUTHENTICATION
# ---------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ---------------------------------------------------
# 5. STORAGE & PRIVATE PRESCRIPTION VAULT
# ---------------------------------------------------
MEDIA_ROOT_DIR=media
PRESCRIPTION_STORAGE_DIR=prescriptions_private
MAX_UPLOAD_SIZE_MB=10

# ---------------------------------------------------
# 6. PAYMENT GATEWAY INTEGRATION (INR)
# ---------------------------------------------------
# Obtain keys from Razorpay Dashboard (https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key
# Optional Stripe / UPI / Paytm credentials
# STRIPE_PUBLIC_KEY=pk_test_placeholder
# STRIPE_SECRET_KEY=sk_test_placeholder

# ---------------------------------------------------
# 7. EMAIL SERVICE (SMTP / AWS SES)
# ---------------------------------------------------
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your_sendgrid_or_ses_api_key
# DEFAULT_FROM_EMAIL=MediSwift Healthcare <noreply@mediswift.in>

# ---------------------------------------------------
# 8. TELEHEALTH VIDEO PROVIDER
# ---------------------------------------------------
# Default uses MediSwift WebRTC room routing
TELEHEALTH_MEETING_PROVIDER=WEBRTC_SECURE
TELEHEALTH_BASE_URL=https://meet.mediswift.in

# ---------------------------------------------------
# 9. FRONTEND ENVIRONMENT CONFIGURATION
# ---------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=MediSwift
NEXT_PUBLIC_APP_TAGLINE="Your Health, Delivered Smarter."
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"
NEXT_PUBLIC_DEFAULT_CITY="Ahmedabad"
NEXT_PUBLIC_DEFAULT_PINCODE="380054"
