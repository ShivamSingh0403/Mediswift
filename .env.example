# ===================================================
# MediSwift Environment Configuration Template
# ===================================================

# GENERAL
DEBUG=True
SECRET_KEY=django-insecure-mediswift-production-grade-secret-key-replace-in-prod-xyz123
ALLOWED_HOSTS=localhost,127.0.0.1,backend,web

# DATABASE (PostgreSQL)
DATABASE_NAME=mediswift_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432

# CORS & SECURITY
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT AUTHENTICATION
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# FILE STORAGE / PRESCRIPTIONS
MEDIA_ROOT_DIR=media
PRESCRIPTION_STORAGE_DIR=prescriptions_private
MAX_UPLOAD_SIZE_MB=10

# FRONTEND
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=MediSwift
NEXT_PUBLIC_APP_TAGLINE="Your Health, Delivered Smarter."
