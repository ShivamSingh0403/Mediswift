# ==========================================
# Mediswift Pro — Production Environment Template
# ==========================================

# Django Core
DEBUG=False
SECRET_KEY=replace_with_a_strong_64_character_random_string_in_production
ALLOWED_HOSTS=api.mediswift.com,your-domain.com,localhost,127.0.0.1
FRONTEND_URL=https://mediswift.vercel.app

# PostgreSQL Database Credentials
DB_NAME=mediswift_db
DB_USER=mediswift_user
DB_PASSWORD=replace_with_secure_production_password
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgres://mediswift_user:replace_with_secure_production_password@db:5432/mediswift_db

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=https://mediswift.vercel.app,http://localhost:3000

# Stripe Payment Gateway (Replace with your actual keys from Stripe Dashboard)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
